<link rel="stylesheet" type="text/css" href="/css/sharejs.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tocbot/4.4.2/tocbot.css">
<div class="pattern-center-blank"></div>
<%
var articleAuthor = post.author || config.author || theme.siteName;
var articleAuthorLink = post.authorLink || theme.url || '/';
var articleAvatar = post.avatar || ((theme.cdn || '') + theme.avatar);
var articleAbout = post.authorAbout || theme.description || '';
var articlePhoto = post.photos && post.photos.length ? post.photos[0] : null;
%>
<% if (articlePhoto) { %>
  <div class="pattern-center single-center">
    <div class="pattern-attachment-img lazyload" style="background-image: url(<%= articlePhoto %>);" src="<%- theme.lazyloadImg %>" data-src="<%= articlePhoto %>">
    </div>
    <header class="pattern-header single-header">
      <h1 class="entry-title"><%- post.title %></h1>
      <p class="entry-census">
        <span>
          <a href="<%- articleAuthorLink %>">
            <img src="<%- articleAvatar %>">
          </a>
        </span>
        <span>
          <a href="<%- articleAuthorLink %>"><%- articleAuthor %></a>
        </span>
        <span class="bull">·</span>
        <%= date(post.date, 'YYYY-M-D') %>
        <span class="bull">·</span>
        <span id="busuanzi_value_page_pv"></span>次阅读
      </p>
    </header>
  </div>
<% } %>
<div id="content" class="site-content">
  <div id="primary" class="content-area">
    <main id="main" class="site-main" role="main">
      <article id="post-1" class="post-1 post type-post status-publish format-standard has-post-thumbnail hentry category-uncategorized">
        <div class="toc"></div>
        <% if (!articlePhoto) { %>
          <header class="entry-header">
            <h1 class="entry-title"><%- post.title %></h1>
            <p class="entry-census">
              <%- articleAuthor %>&nbsp;·&nbsp;<%= date(post.date, 'YYYY-M-D') %>&nbsp;·&nbsp;<span id="busuanzi_value_page_pv"></span>次阅读
            </p>
            <hr>
          </header>
        <% } %>
        <div class="entry-content">
          <%- post.content %>
        </div>
        <% if (theme.donate && theme.donate.enable !== false) { %>
          <div class="single-reward">
            <div class="reward-open">赏
              <div class="reward-main">
                <ul class="reward-row">
                  <li class="alipay-code"><img src="<%- (theme.cdn || '') + theme.donate.alipay %>"></li>
                  <li class="wechat-code"><img src="<%- (theme.cdn || '') + theme.donate.wechat %>"></li>
                </ul>
              </div>
            </div>
          </div>
        <% } %>
        <div style="text-align:center; width: 100%" class="social-share share-mobile" data-disabled="diandian, tencent"></div>
        <footer class="post-footer">
          <div class="post-lincenses"><a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh" target="_blank" rel="nofollow"><i class="fa fa-creative-commons" aria-hidden="true"></i> CC BY-NC-SA 4.0</a></div>
          <div class="post-tags"></div>
          <div class="post-share">
            <div class="social-share sharehidden share-component"></div>
            <i class="iconfont show-share icon-forward"></i>
          </div>
        </footer>
      </article>
      <div class="toc" style="background: none;"></div>
      <section class="post-squares nextprev">
        <% if (post.prev) { %>
          <% if (post.next) { %>
            <div class="post-nepre half previous">
          <% } else { %>
            <div class="post-nepre full previous">
          <% } %>
            <a href="<%- url_for(post.prev.path) %>" rel="prev">
              <div class="background">
                <img class="lazyload" src="<%- theme.lazyloadImg %>" data-src="<%- post.prev.photos[0] %>" style="width: 100%; height: 100%; object-fit: cover; pointer-events: none;" onerror="imgError(this,3)">
              </div>
              <span class="label">上一篇</span>
              <div class="info">
                <h3><%= post.prev.title %></h3>
                <hr>
              </div>
            </a>
          </div>
        <% } %>
        <% if (post.next) { %>
          <% if (post.prev) { %>
            <div class="post-nepre half next">
          <% } else { %>
            <div class="post-nepre full next">
          <% } %>
            <a href="<%- url_for(post.next.path) %>" rel="next">
              <div class="background">
                <img class="lazyload" src="<%- theme.lazyloadImg %>" data-src="<%- post.next.photos[0] %>" style="width: 100%; height: 100%; object-fit: cover; pointer-events: none;" onerror="imgError(this,3)">
              </div>
              <span class="label">下一篇</span>
              <div class="info">
                <h3><%= post.next.title %></h3>
                <hr>
              </div>
            </a>
          </div>
        <% } %>
      </section>
      <%- partial('_partial/comment') %>
      <section class="author-profile">
        <div class="info" itemprop="author" itemscope="" itemtype="https://schema.org/Person">
          <a href="<%- articleAuthorLink %>" class="profile gravatar"><img src="<%- articleAvatar %>" itemprop="image" alt="<%- articleAuthor %>" height="70" width="70"></a>
          <div class="meta">
            <span class="title">关于作者</span>
            <h3 itemprop="name">
              <a href="<%- articleAuthorLink %>" itemprop="url" rel="author"><%- articleAuthor %></a>
            </h3>
          </div>
        </div>
        <hr>
        <p><i class="iconfont icon-write"></i><%- articleAbout %></p>
      </section>
    </main>
  </div>
</div>

<% if (post.mathjax) { %>
  <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.4/latest.js?config=TeX-MML-AM_CHTML"></script>
  <script type="text/x-mathjax-config">
    MathJax.Hub.Config({tex2jax: {inlineMath: [['$','$'], ['\\(','\\)']]}});
  </script>
<% } %>
