<%_ if (home === true) { _%>
  <%_ if (theme.home_categories?.enable) { _%>
    <div class="post-categories-wrapper" data-aos="<%= theme.animation.options.home.post %>">
      <%_ for (let content of theme.home_categories.content) { _%>
        <%_ if (content.categories) { _%>
        <div class="post-categories-wrap">
          <%_ let c = parseHomeCategories(content.categories); _%>
          <a class="post-link" href="<%= url_for_lang(c.url, {relative: false}) %>" aria-label="<%= c.name %>" title="<%= c.name %>"></a>
          <div class="post-categories-cover">
            <%_ if (content.cover) { _%>
              <img data-src="<%- url_for(content.cover, {relative: false}) %>" data-sizes="auto" alt="<%= c.name %>" class="lazyload">
            <%_ } else { _%>
              <%_ let cover = randomCover(); _%>
              <%_ if (cover) { _%>
                <img data-src="<%= cover %>" data-sizes="auto" alt="<%= c.name %>" class="lazyload">
              <%_ } else { _%>
                <img data-src="<%- url_for(theme.banner, {relative: false}) %>" data-sizes="auto" alt="<%= c.name %>" class="lazyload">
              <%_ } _%>
            <%_ } _%>
            <h2><%= c.name %></h2>
            <h3><%= _p('home_categories.count', c.count) %></h3>
          </div>
        </div>
        <%_ } _%>
      <%_ } _%>
    </div>
  <%_ } _%>
  <section class="home-purpose" data-aos="<%= theme.animation.options.home.post %>">
    <div class="home-purpose__grid">
      <article class="home-purpose__summary">
        <p class="home-purpose__eyebrow">Site Focus</p>
        <h2>记录真实项目、问题排查和实习复盘</h2>
        <p class="home-purpose__summary-text">
          首页先按分类看内容，文章里再展开背景、方案、排查过程和最终结论。
        </p>
        <div class="home-purpose__chips">
          <span>项目记录</span>
          <span>问题排查</span>
          <span>实习复盘</span>
          <span>持续更新</span>
        </div>
      </article>
      <article class="home-purpose__card">
        <span class="home-purpose__badge">01</span>
        <h3>需求到交付</h3>
        <p>把背景、目标、方案选择和交付结果拆开写，避免只有结论没有上下文。</p>
      </article>
      <article class="home-purpose__card">
        <span class="home-purpose__badge">02</span>
        <h3>问题到结论</h3>
        <p>记录现象、假设、验证和修复方式，让排查过程以后还能继续复用。</p>
      </article>
      <article class="home-purpose__card">
        <span class="home-purpose__badge">03</span>
        <h3>经验沉淀</h3>
        <p>把实习里真正值得保留的方法、习惯和判断标准，一点点沉淀下来。</p>
      </article>
    </div>
  </section>
  <section class="home-notes" data-aos="<%= theme.animation.options.home.post %>">
    <div class="home-notes__panel">
      <p class="home-purpose__eyebrow">What To Expect</p>
      <h2>更新时会尽量保留过程，而不是只贴最后答案</h2>
      <ul>
        <li>先交代场景，再写技术点，避免内容脱离上下文。</li>
        <li>能说明为什么这样做，就不只写“最后用了什么方案”。</li>
        <li>同一类问题后续再出现，会继续补充在原有思路基础上。</li>
      </ul>
    </div>
    <div class="home-notes__aside">
      <div class="home-notes__aside-card">
        <span>01</span>
        <h3>适合谁看</h3>
        <p>适合对实习项目、问题排查和工作复盘感兴趣的人。</p>
      </div>
      <div class="home-notes__aside-card">
        <span>02</span>
        <h3>怎么阅读</h3>
        <p>可以按分类浏览，也可以直接从最新文章进入具体项目或问题。</p>
      </div>
      <div class="home-notes__aside-card">
        <span>03</span>
        <h3>更新方式</h3>
        <p>后面你把真实问题和解决过程告诉我，我会继续整理成适合公开阅读的版本。</p>
      </div>
    </div>
  </section>
  <%_ if (page.lang) { _%>
    <%_ let i = 0; _%>
    <%_ for (const post of get_posts_by_lang(page.posts, page.lang)) { _%>
      <%- partial('post', {post: post, even: i % 2 === 0}) %>
      <%_ i++; _%>
    <%_ } _%>
  <%_ } else { _%>
    <%_ page.posts.forEach((post, i) => { _%>
      <%- partial('post', {post: post, even: i % 2 === 0}) %>
    <%_ }) _%>
  <%_ } _%>
<%_ } else { _%>
<div class="archives-outer-wrap" data-aos="<%= theme.animation.options.archive.whole %>">
  <%_ if (theme.only_show_capsule_in_index) { _%>
    <%_ if (page.current === 1 && page.archive) { _%>
      <%- partial_lang('post/archives', null, { cache: !config.relative_link, lang: page.lang }) %>
    <%_ } _%>
  <%_ } else { _%>
    <%- partial_lang('post/archives', null, { cache: !config.relative_link, lang: page.lang }) %>
  <%_ } _%>
  <%_ if (page.lang) { _%>
    <%_ const posts = get_posts_by_lang(page.posts, page.lang); _%>
    <%_ var last; _%>
    <%_ posts.forEach((post, i) => { _%>
      <%_ var year = post.date.year(); _%>
      <%_ if (last != year) { _%>
        <%_ if (last != null) { _%>
          </section>
        <%_ } _%>
        <%_ last = year; _%>
        <section class="archives-wrap" data-aos="<%= theme.animation.options.archive.section %>">
          <div class="archive-year-wrap">
            <a href="<%- url_for_lang(config.archive_dir + '/' + year) %>" class="archive-year"><%= year %></a>
          </div>
          <ul>
            <%_ } _%>
            <%- partial('archive-post', {post: post}) %>
            <%_ }) _%>
            <%_ if (page.posts.length) { _%>
          </ul>
        </section>
    <%_ } _%>
  <%_ } else { _%>
    <%_ var last; _%>
    <%_ page.posts.each((post, i) => { _%>
      <%_ var year = post.date.year(); _%>
      <%_ if (last != year) { _%>
        <%_ if (last != null) { _%>
          </section>
        <%_ } _%>
        <%_ last = year; _%>
        <section class="archives-wrap" data-aos="<%= theme.animation.options.archive.section %>">
          <div class="archive-year-wrap">
            <a href="<%- url_for_lang(config.archive_dir + '/' + year) %>" class="archive-year"><%= year %></a>
          </div>
          <ul>
            <%_ } _%>
            <%- partial('archive-post', {post: post}) %>
            <%_ }) _%>
            <%_ if (page.posts.length) { _%>
          </ul>
        </section>
    <%_ } _%>
  <%_ } _%>
  </div>
<%_ } _%>
<%_ if (page.total > 1) { _%>
  <nav id="page-nav" aria-label="Pagination navigation" data-aos="<%= theme.animation.options.archive.nav %>">
    <%_ let prev_text = "&laquo; " + __('prev');let next_text = __('next') + " &raquo;" _%>
    <%- paginator({
          prev_text: prev_text,
          next_text: next_text,
          escape: false
      }) %>
  </nav>
<%_ } _%>
