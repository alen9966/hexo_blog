tle h3,\n.button-normal,\n.top-social_v2 li,\n.site-title a {\n  transition:\n    transform 0.24s ease,\n    box-shadow 0.24s ease,\n    background-color 0.24s ease,\n    color 0.24s ease,\n    opacity 0.24s ease;\n  will-change: transform;\n}\n\n.focusinfo .header-tou img {\n  transition:\n    transform 0.24s ease,\n    box-shadow 0.24s ease,\n    border-color 0.24s ease;\n  will-change: transform;\n}\n\n.notice,\n.top-feature,\n.post-list-thumb,\n.author-profile,\n.post-item {\n  background: var(--project-surface);\n  border: 1px solid var(--project-border);\n  box-shadow: var(--project-shadow);\n}\n\n.notice,\n.top-feature,\n.post-list-thumb,\n.author-profile {\n  border-radius: 22px;\n  overflow: hidden;\n}\n\n.post-list-thumb:hover,\n.top-feature:hover,\n.notice:hover,\n.author-profile:hover {\n  transform: translateY(-4px);\n  box-shadow: var(--project-shadow-strong) !important;\n}\n\n.headertop {\n  height: 390px !important;\n  min-height: 390px !important;\n}\n\n.headertop::before {\n  background:\n    linear-gradient(135deg, rgba(10, 28, 54, 0.7), rgba(22, 119, 255, 0.34)) !important;\n}\n\n#banner_wave_1,\n#banner_wave_2,\n.headertop-down {\n  display: none !important;\n}\n\n.focusinfo {\n  width: min(760px, calc(100% - 48px));\n  padding: 30px 38px;\n  border: 1px solid rgba(255, 255, 255, 0.2);\n  border-radius: 24px;\n  background: rgba(6, 20, 38, 0.58);\n  box-shadow: 0 24px 64px rgba(3, 17, 32, 0.25);\n  backdrop-filter: blur(12px);\n}\n\n.focusinfo .header-info p {\n  max-width: 56rem;\n  font-size: 1.06rem;\n  line-height: 1.9;\n  color: #eef6ff;\n  text-shadow: none;\n}\n\n.focusinfo .header-tou img {\n  width: 92px;\n  height: 92px;\n  border: 2px solid rgba(255, 255, 255, 0.5);\n  box-shadow: 0 16px 34px rgba(9, 26, 48, 0.2);\n  animation: none;\n}\n\n.site-top {\n  backdrop-filter: blur(14px);\n  background: rgba(255, 255, 255, 0.88);\n  box-shadow: 0 10px 24px rgba(22, 50, 79, 0.08);\n}\n\n.site-top ul li a {\n  border-radius: 999px;\n  padding: 0.18rem 0.78rem;\n}\n\n.site-top ul li a:hover {\n  background: rgba(22, 119, 255, 0.08);\n}\n\n.notice {\n  margin-top: 24px !important;\n  padding: 18px 22px;\n}\n\n.notice-content {\n  color: #315172;\n  line-height: 1.85;\n}\n\n.top-feature-row {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 18px;\n  margin-top: 24px;\n}\n\n.top-feature-row > h1 {\n  grid-column: 1 / -1;\n  margin: 0;\n}\n\n.top-feature-v2 {\n  display: block;\n}\n\n.the-feature.from_left_and_right {\n  width: 100%;\n  height: 220px;\n  border-radius: 22px;\n  box-shadow: none;\n}\n\n.the-feature img {\n  width: 100%;\n  height: 220px;\n  object-fit: cover;\n}\n\n.the-feature.from_left_and_right .img,\n.the-feature.from_left_and_right a:hover .img {\n  transform: none;\n}\n\n.the-feature.from_left_and_right .info {\n  top: auto;\n  visibility: visible;\n  opacity: 1;\n  background: linear-gradient(180deg, rgba(6, 24, 44, 0) 0%, rgba(6, 24, 44, 0.84) 100%);\n}\n\n.the-feature.from_left_and_right .info h3,\n.the-feature.from_left_and_right .info p,\n.the-feature.from_left_and_right a:hover .info h3,\n.the-feature.from_left_and_right a:hover .info p {\n  transform: none;\n}\n\n.the-feature.from_left_and_right .info h3 {\n  margin: 106px 0 0;\n  padding: 0 18px;\n  font-size: 1.1rem;\n  text-transform: none;\n  text-align: left;\n  background: transparent;\n}\n\n.the-feature.from_left_and_right .info p {\n  padding: 10px 18px 18px;\n  font-size: 0.92rem;\n  line-height: 1.75;\n  color: rgba(240, 247, 255, 0.88);\n  text-align: left;\n}\n\n.main-title,\n.fes-title {\n  letter-spacing: 0.06em;\n}\n\n#video-btn,\n#video-add,\n.video-stu {\n  display: none !important;\n}\n\n.post-list-thumb {\n  margin-top: 18px;\n  border-radius: 24px;\n}\n\n.post-list-thumb .post-thumb,\n.post-list-thumb-left .post-thumb {\n  width: 48%;\n}\n\n.post-list-thumb .post-thumb img {\n  object-fit: cover;\n}\n\n.post-list-thumb .post-title h3 {\n  font-weight: 700;\n  line-height: 1.45;\n  color: var(--project-ink);\n}\n\n.post-list-thumb:hover .post-title h3,\n.entry-title a:hover,\n.post-title:hover h3 {\n  background: none;\n  color: var(--project-accent) !important;\n}\n\n.post-meta a {\n  display: inline-block;\n  margin: 0 0.35rem 0.35rem 0;\n  padding: 0.14rem 0.62rem;\n  border-radius: 999px;\n  background: rgba(22, 119, 255, 0.08);\n  color: #315172 !important;\n}\n\n.post-meta a:hover {\n  background: rgba(22, 119, 255, 0.14);\n  color: var(--project-accent) !important;\n  transform: none;\n}\n\n.button-normal,\n.download,\n#pagination a {\n  border-radius: 999px;\n  background: linear-gradient(135deg, var(--project-accent), var(--project-accent-2));\n  box-shadow: 0 10px 24px rgba(22, 119, 255, 0.18);\n}\n\n.button-normal:hover,\n.download:hover,\n#pagination a:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 14px 30px rgba(22, 119, 255, 0.24);\n}\n\n.pattern-center-blank {\n  height: 150px;\n}\n\n.pattern-center {\n  height: 340px;\n  isolation: isolate;\n}\n\n.pattern-center::before {\n  z-index: 1;\n  background: linear-gradient(90deg, rgba(4, 15, 29, 0.8), rgba(4, 15, 29, 0.42) 58%, rgba(4, 15, 29, 0.28)) !important;\n}\n\n.pattern-center .pattern-attachment-img {\n  filter: saturate(0.82) brightness(0.83);\n}\n\n.pattern-center header.pattern-header,\n.pattern-center header.single-header {\n  z-index: 3;\n  width: min(920px, calc(100% - 48px));\n  left: 50%;\n  top: 50%;\n  bottom: auto;\n  transform: translate(-50%, -43%);\n  text-align: left;\n}\n\n.pattern-center h1.cat-title,\n.pattern-center h1.entry-title,\n.single-center .single-header h1.entry-title {\n  font-weight: 700;\n  letter-spacing: 0.015em;\n  color: #fff !important;\n  text-shadow: 0 3px 18px rgba(0, 0, 0, 0.55) !important;\n}\n\n.single-center .single-header h1.entry-title {\n  max-width: 780px;\n  margin: 0 0 18px !important;\n  font-size: clamp(1.9rem, 3.2vw, 3rem) !important;\n  line-height: 1.25;\n}\n\n.single-center .single-header .entry-census,\n.single-center .single-header .entry-census a {\n  color: rgba(255,255,255,.88) !important;\n  text-shadow: 0 2px 12px rgba(0,0,0,.45);\n}\n\n.single-center .single-header .entry-census img {\n  border: 2px solid rgba(255,255,255,.78);\n}\n\n.post-content-wrap {\n  padding: 28px 34px !important;\n}\n\n.float-content {\n  min-height: 0 !important;\n}\n\n.float-content p {\n  display: -webkit-box;\n  margin-top: 16px !important;\n  overflow: hidden;\n  color: #536b82;\n  line-height: 1.75 !important;\n  -webkit-line-clamp: 3;\n  -webkit-box-orient: vertical;\n}\n\n.post-bottom {\n  position: static !important;\n  margin-top: 18px;\n}\n\n/* Standalone pages */\n.post-item.post-301 {\n  max-width: 920px;\n  margin: 34px auto 0;\n  padding: 42px 52px;\n  border-radius: 24px;\n}\n\n.post-item.post-301 h2:first-child { margin-top: 0; }\n\n/* Archive */\n.blank { padding-top: 110px; }\n#content #main { max-width: 920px; margin: 0 auto; }\n#content #main .page-header { margin-bottom: 26px; text-align: left; }\n#content #main .page-header .cat-title { display: inline; font-size: 2rem; color: var(--project-ink); }\n#content #main .page-header .cat-des { margin-left: 10px; color: #8396a8; }\n#archives { padding: 10px 6px 32px; }\n#archives > p { margin-bottom: 28px; color: #7890a5; }\n#archives .al_year { margin: 18px 0; font-size: 1.35rem; color: var(--project-ink); }\n.al_mon_list { margin: 0; padding: 0; list-style: none; }\n.al_mon_card { display: inline-flex; margin-bottom: 14px; padding: 7px 13px; border-radius: 999px; background: #eaf3ff; color: #24557c; font-weight: 700; box-shadow: none; }\n.al_post_list { margin: 0 0 28px 11px; padding: 0 0 0 24px; border-left: 2px solid #dce9f5; list-style: none; }\n.al_post_list li { position: relative; padding: 11px 0; }\n.al_post_list li::before { position: absolute; left: -31px; top: 20px; width: 10px; height: 10px; border: 2px solid #fff; border-radius: 50%; background: var(--project-accent); box-shadow: 0 0 0 2px #bcd7ee; content: ''; }\n.al_post_list a { color: #264b6b; }\n.al_post_list a:hover { color: var(--project-accent); }\n.archive-date { display: inline-block; min-width: 122px; color: #71879a; font-variant-numeric: tabular-nums; }\n}\n\n.entry-content h1,\n.entry-content h2,\n.entry-content h3,\n.single-center .single-header h1.entry-title,\n.post-item h1.entry-title {\n  font-weight: 700;\n  color: var(--project-ink);\n}\n\n.entry-content h2 {\n  margin-top: 1.9em;\n  padding-left: 14px;\n  border-left: 4px solid var(--project-accent);\n}\n\n.entry-content table {\n  width: 100%;\n  border-collapse: collapse;\n  overflow: hidden;\n  border-radius: 16px;\n  box-shadow: inset 0 0 0 1px rgba(22, 50, 79, 0.08);\n}\n\n.entry-content table th,\n.entry-content table td {\n  padding: 12px 14px;\n  border-bottom: 1px solid rgba(22, 50, 79, 0.08);\n}\n\n.entry-content table th {\n  background: rgba(22, 119, 255, 0.08);\n  color: var(--project-ink);\n  font-weight: 700;\n}\n\n.author-profile i,\n.post-like a,\n.post-share .show-share,\n.sub-text,\n.we-info a,\nspan.sitename,\n.post-more i:hover,\n#pagination a:hover,\n.post-content a:hover,\n.float-content i:hover,\n.entry-content a:hover,\n.site-info a:hover,\n.comment h4 a,\n#comments-navi a.prev,\n#comments-navi a.next,\n.comment h4 a:hover,\n.site-top ul li a:hover,\n.entry-title a:hover,\n#archives-temp h3,\nspan.page-numbers.current,\n.sorry li a:hover,\n.site-title a:hover,\ni.iconfont.js-toggle-search.iconsearch:hover,\n.comment-respond input[type='submit']:hover {\n  color: var(--project-accent);\n}\n\n.feature i,\n.navigator i:hover,\n.links ul li:before,\n.ar-time i,\nspan.ar-circle,\n.object,\n.comment .comment-reply-link,\n.siren-checkbox-radio:checked + .siren-checkbox-radioInput:after {\n  background: var(--project-accent);\n}\n\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n\n::-webkit-scrollbar-track {\n  background: rgba(22, 50, 79, 0.05);\n}\n\n::-webkit-scrollbar-thumb {\n  background: linear-gradient(180deg, var(--project-accent), var(--project-accent-2));\n  border-radius: 999px;\n}\n\n@media (max-width: 860px) {\n  .headertop {\n    height: 260px !important;\n    min-height: 260px !important;\n  }\n\n  .focusinfo {\n    width: calc(100% - 24px);\n    padding: 18px 18px 20px;\n  }\n\n  .top-feature-row {\n    grid-template-columns: 1fr;\n  }\n\n  .the-feature.from_left_and_right,\n  .the-feature img {\n    height: 200px;\n  }\n\n  .the-feature.from_left_and_right .info h3 {\n    margin-top: 96px;\n  }\n\n  .pattern-center-blank {\n    height: 108px;\n  }\n\n  .pattern-center {\n    height: 250px;\n  }\n\n  .pattern-center header.pattern-header,\n  .pattern-center header.single-header { width: calc(100% - 32px); }\n  .single-center .single-header h1.entry-title { font-size: 1.55rem !important; }\n  .post-item.post-301 { margin: 20px 12px 0; padding: 28px 22px; }\n  .archive-date { display: block; min-width: 0; font-size: .82rem; }\n}\n\n/* =========================================\n   Performance Optimizations\n   ========================================= */\n\n/* 减少动画偏好支持 */\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n  html { scroll-behavior: auto !important; }\n}\n\n/* 移动端禁用高成本的毛玻璃效果 */\n@media (max-width: 860px) {\n  .focusinfo,\n  .site-top {\n    backdrop-filter: none !important;\n    -webkit-backdrop-filter: none !important;\n  }\n  .focusinfo {\n    background: rgba(6, 20, 38, 0.78);\n  }\n  .site-top {\n    background: rgba(255, 255, 255, 0.95);\n  }\n}\n\n/* 列表内容虚拟化优化 */\n.post-list-thumb,\n.post-item,\n.top-feature,\n.notice,\n.author-profile {\n  content-visibility: auto;\n  contain: layout paint style;\n}\n\n/* Hover 优化 - 提前提升合成层 */\n.post-list-thumb,\n.top-feature,\n.notice,\n.author-profile,\n#pagination a,\n.button-normal {\n  transform: translateZ(0)