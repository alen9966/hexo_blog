portant;\n}\n\n.float-content {\n  min-height: 0 !important;\n}\n\n.float-content p {\n  display: -webkit-box;\n  margin-top: 16px !important;\n  overflow: hidden;\n  color: #536b82;\n  line-height: 1.75 !important;\n  -webkit-line-clamp: 3;\n  -webkit-box-orient: vertical;\n}\n\n.post-bottom {\n  position: static !important;\n  margin-top: 18px;\n}\n\n/* Standalone pages */\n.post-item.post-301 {\n  max-width: 920px;\n  margin: 34px auto 0;\n  padding: 42px 52px;\n  border-radius: 24px;\n}\n\n.post-item.post-301 h2:first-child { margin-top: 0; }\n\n/* Archive */\n.blank { padding-top: 110px; }\n#content #main { max-width: 920px; margin: 0 auto; }\n#content #main .page-header { margin-bottom: 26px; text-align: left; }\n#content #main .page-header .cat-title { display: inline; font-size: 2rem; color: var(--project-ink); }\n#content #main .page-header .cat-des { margin-left: 10px; color: #8396a8; }\n#archives { padding: 10px 6px 32px; }\n#archives > p { margin-bottom: 28px; color: #7890a5; }\n#archives .al_year { margin: 18px 0; font-size: 1.35rem; color: var(--project-ink); }\n.al_mon_list { margin: 0; padding: 0; list-style: none; }\n.al_mon_card { display: inline-flex; margin-bottom: 14px; padding: 7px 13px; border-radius: 999px; background: #eaf3ff; color: #24557c; font-weight: 700; box-shadow: none; }\n.al_post_list { margin: 0 0 28px 11px; padding: 0 0 0 24px; border-left: 2px solid #dce9f5; list-style: none; }\n.al_post_list li { position: relative; padding: 11px 0; }\n.al_post_list li::before { position: absolute; left: -31px; top: 20px; width: 10px; height: 10px; border: 2px solid #fff; border-radius: 50%; background: var(--project-accent); box-shadow: 0 0 0 2px #bcd7ee; content: ''; }\n.al_post_list a { color: #264b6b; }\n.al_post_list a:hover { color: var(--project-accent); }\n.archive-date { display: inline-block; min-width: 122px; color: #71879a; font-variant-numeric: tabular-nums; }\n}\n\n.entry-content h1,\n.entry-content h2,\n.entry-content h3,\n.single-center .single-header h1.entry-title,\n.post-item h1.entry-title {\n  font-weight: 700;\n  color: var(--project-ink);\n}\n\n.entry-content h2 {\n  margin-top: 1.9em;\n  padding-left: 14px;\n  border-left: 4px solid var(--project-accent);\n}\n\n.entry-content table {\n  width: 100%;\n  border-collapse: collapse;\n  overflow: hidden;\n  border-radius: 16px;\n  box-shadow: inset 0 0 0 1px rgba(22, 50, 79, 0.08);\n}\n\n.entry-content table th,\n.entry-content table td {\n  padding: 12px 14px;\n  border-bottom: 1px solid rgba(22, 50, 79, 0.08);\n}\n\n.entry-content table th {\n  background: rgba(22, 119, 255, 0.08);\n  color: var(--project-ink);\n  font-weight: 700;\n}\n\n.author-profile i,\n.post-like a,\n.post-share .show-share,\n.sub-text,\n.we-info a,\nspan.sitename,\n.post-more i:hover,\n#pagination a:hover,\n.post-content a:hover,\n.float-content i:hover,\n.entry-content a:hover,\n.site-info a:hover,\n.comment h4 a,\n#comments-navi a.prev,\n#comments-navi a.next,\n.comment h4 a:hover,\n.site-top ul li a:hover,\n.entry-title a:hover,\n#archives-temp h3,\nspan.page-numbers.current,\n.sorry li a:hover,\n.site-title a:hover,\ni.iconfont.js-toggle-search.iconsearch:hover,\n.comment-respond input[type='submit']:hover {\n  color: var(--project-accent);\n}\n\n.feature i,\n.navigator i:hover,\n.links ul li:before,\n.ar-time i,\nspan.ar-circle,\n.object,\n.comment .comment-reply-link,\n.siren-checkbox-radio:checked + .siren-checkbox-radioInput:after {\n  background: var(--project-accent);\n}\n\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n\n::-webkit-scrollbar-track {\n  background: rgba(22, 50, 79, 0.05);\n}\n\n::-webkit-scrollbar-thumb {\n  background: linear-gradient(180deg, var(--project-accent), var(--project-accent-2));\n  border-radius: 999px;\n}\n\n@media (max-width: 860px) {\n  .headertop {\n    height: 260px !important;\n    min-height: 260px !important;\n  }\n\n  .focusinfo {\n    width: calc(100% - 24px);\n    padding: 18px 18px 20px;\n  }\n\n  .top-feature-row {\n    grid-template-columns: 1fr;\n  }\n\n  .the-feature.from_left_and_right,\n  .the-feature img {\n    height: 200px;\n  }\n\n  .the-feature.from_left_and_right .info h3 {\n    margin-top: 96px;\n  }\n\n  .pattern-center-blank {\n    height: 108px;\n  }\n\n  .pattern-center {\n    height: 250px;\n  }\n\n  .pattern-center header.pattern-header,\n  .pattern-center header.single-header { width: calc(100% - 32px); }\n  .single-center .single-header h1.entry-title { font-size: 1.55rem !important; }\n  .post-item.post-301 { margin: 20px 12px 0; padding: 28px 22px; }\n  .archive-date { display: block; min-width: 0; font-size: .82rem; }\n}\n\n/* =========================================\n   Performance Optimizations\n   ========================================= */\n\n/* 减少动画偏好支持 */\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n  html { scroll-behavior: auto !important; }\n}\n\n/* 移动端禁用高成本的毛玻璃效果 */\n@media (max-width: 860px) {\n  .focusinfo,\n  .site-top {\n    backdrop-filter: none !important;\n    -webkit-backdrop-filter: none !important;\n  }\n  .focusinfo {\n    background: rgba(6, 20, 38, 0.78);\n  }\n  .site-top {\n    background: rgba(255, 255, 255, 0.95);\n  }\n}\n\n/* 列表内容虚拟化优化 */\n.post-list-thumb,\n.post-item,\n.top-feature,\n.notice,\n.author-profile {\n  content-visibility: auto;\n  contain: layout paint style;\n}\n\n/* Hover 优化 - 提前提升合成层 */\n.post-list-thumb,\n.top-feature,\n.notice,\n.author-profile,\n#pagination a,\n.button-normal {\n  transform: translateZ(0);\n  backface-visibility: hidden;\n}\n"},{"_content":":root {\n  --sakura-pink: #f06c8d;\n  --sakura-peach: #ffb38a;\n  --sakura-sky: #77b8ff;\n  --sakura-mint: #69d2b0;\n  --sakura-lilac: #a98bff;\n  --sakura-border: rgba(240, 108, 141, 0.12);\n  --sakura-shadow: 0 20px 45px rgba(96, 79, 116, 0.12);\n}\n\nhtml {\n  scroll-behavior: smooth;\n}\n\nbody {\n  background:\n    radial-gradient(circle at top left, rgba(240, 108, 141, 0.08), transparent 35%),\n    radial-gradient(circle at top right, rgba(119, 184, 255, 0.08), transparent 40%),\n    linear-gradient(180deg, #fffafc 0%, #f7f9ff 50%, #fffefc 100%);\n  background-attachment: fixed;\n}\n\n#header::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background:\n    linear-gradient(120deg, rgba(240, 108, 141, 0.18) 0%, rgba(255, 179, 138, 0.1) 30%, rgba(119, 184, 255, 0.1) 68%, rgba(169, 139, 255, 0.1) 100%);\n  z-index: -1;\n}\n\n#header::after {\n  content: \"\";\n  position: absolute;\n  inset: auto 0 0;\n  height: 160px;\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(255, 250, 252, 0.82) 72%, rgba(255, 250, 252, 0.96) 100%);\n  z-index: -1;\n  pointer-events: none;\n}\n\n#header #subtitle,\n#header h1 {\n  text-shadow: 0 10px 24px rgba(64, 48, 74, 0.14);\n}\n\n#header-nav {\n  top: 16px;\n  left: 50%;\n  right: auto;\n  width: min(92%, 880px);\n  padding: 10px 16px;\n  border: 1px solid rgba(255, 255, 255, 0.6);\n  border-radius: 999px;\n  background: rgba(255, 255, 255, 0.72);\n  backdrop-filter: blur(18px);\n  -webkit-backdrop-filter: blur(18px);\n  box-shadow: 0 18px 40px rgba(96, 79, 116, 0.14);\n  transform: translateX(-50%);\n  justify-content: space-between;\n}\n\n#header-nav:hover {\n  background: rgba(255, 255, 255, 0.8);\n}\n\n#header-nav.header-nav-hidden {\n  top: -96px;\n}\n\n#main-nav,\n#sub-nav {\n  gap: 8px;\n}\n\n.main-nav-icon {\n  display: none !important;\n}\n\n.main-nav-link-wrap {\n  padding: 0 !important;\n  border-radius: 999px;\n  opacity: 1;\n}\n\n.main-nav-link {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 40px;\n  padding: 0 18px;\n  border-radius: 999px;\n  color: #7b5d7c;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  background: transparent;\n  transition:\n    background-color 0.22s ease,\n    color 0.22s ease,\n    box-shadow 0.22s ease;\n}\n\n.main-nav-link-wrap:hover .main-nav-link {\n  color: #fff;\n  background: linear-gradient(135deg, var(--sakura-pink), #f7a2b6);\n  box-shadow: 0 12px 26px rgba(240, 108, 141, 0.26);\n}\n\n#sub-nav .nav-icon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 40px;\n  height: 40px;\n  padding: 0;\n  border-radius: 50%;\n  color: #8f6e8c;\n  background: rgba(240, 108, 141, 0.08);\n  transition:\n    background-color 0.22s ease,\n    color 0.22s ease,\n    transform 0.22s ease,\n    box-shadow 0.22s ease;\n  will-change: transform;\n}\n\n#sub-nav .nav-icon:hover {\n  color: #fff;\n  background: linear-gradient(135deg, var(--sakura-sky), var(--sakura-lilac));\n  box-shadow: 0 12px 26px rgba(119, 184, 255, 0.22);\n  transform: translateY(-2px);\n}\n\n[data-theme=\"dark\"] #header-nav {\n  border-color: rgba(255, 255, 255, 0.08);\n  background: rgba(24, 28, 37, 0.72);\n  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);\n}\n\n[data-theme=\"dark\"] #header-nav:hover {\n  background: rgba(24, 28, 37, 0.82);\n}\n\n[data-theme=\"dark\"] .main-nav-link {\n  color: rgba(237, 227, 238, 0.9);\n}\n\n[data-theme=\"dark\"] #sub-nav .nav-icon {\n  color: rgba(237, 227, 238, 0.9);\n  background: rgba(255, 255, 255, 0.08);\n}\n\n.home-purpose,\n.home-notes {\n  margin: 0 0 32px;\n}\n\n.home-purpose {\n  display: grid;\n  gap: 24px;\n}\n\n.home-purpose__intro,\n.home-purpose__summary,\n.home-notes__panel,\n.home-notes__aside-card,\n.widget-wrap,\n.post-wrap {\n  backdrop-filter: blur(8px) saturate(1.2);\n  -webkit-backdrop-filter: blur(8px) saturate(1.2);\n  transform: translateZ(0);\n  -webkit-transform: translateZ(0);\n}\n\n.home-purpose__intro,\n.home-purpose__summary,\n.home-notes__panel,\n.home-notes__aside-card {\n  border-radius: 30px;\n  border: 1px solid var(--sakura-border);\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.82) 0%, rgba(255, 247, 250, 0.92) 100%);\n  box-shadow: var(--sakura-shadow);\n}\n\n[data-theme=\"dark\"] body {\n  background:\n    radial-gradient(circle at top left, rgba(240, 108, 141, 0.18), transparent 28%),\n    radial-gradient(circle at top right, rgba(119, 184, 255, 0.14), transparent 32%),\n    linear-gradient(180deg, #14161c 0%, #191c24 42%, #11141a 100%);\n}\n\n[data-theme=\"dark\"] .home-purpose__intro,\n[data-theme=\"dark\"] .home-purpose__summary,\n[data-theme=\"dark\"] .home-notes__panel,\n[data-theme=\"dark\"] .home-notes__aside-card,\n[data-theme=\"dark\"] .widget-wrap,\n[data-theme=\"dark\"] .post-wrap {\n  border-color: rgba(255, 255, 255, 0.08);\n  background: linear-gradient(180deg, rgba(29, 32, 43, 0.82) 0%, rgba(22, 26, 35, 0.94) 100%);\n  box-shadow: 0 18px 48px rgba(0, 0, 0, 0.26);\n}\n\n.home-purpose__intro {\n  padding: 38px;\n  position: relative;\n  overflow: hidden;\n}\n\n.home-purpose__intro::before,\n.home-purpose__intro::after {\n  content: \"\";\n  position: absolute;\n  border-radius: 999px;\n  pointer-events: none;\n}\n\n.home-purpose__intro::before {\n  top: -42px;\n  right: -36px;\n  width: 220px;\n  height: 220px;\n  background: radial-gradient(circle, rgba(119, 184, 255, 0.24) 0%, rgba(119, 184, 255, 0) 72%);\n}\n\n.home-purpose__intro::after {\n  left: -40px;\n  bottom: -66px;\n  width: 240px;\n  height: 240px;\n  background: radial-gradient(circle, rgba(240, 108, 141, 0.18) 0%, rgba(240, 108, 141, 0) 72%);\n}\n\n.home-purpose__eyebrow {\n  margin: 0 0 10px;\n  color: var(--sakura-pink);\n  font-size: 0.82rem;\n  font-weight: 700;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n}\n\n.home-purpose__intro h2,\n.home-notes__panel h2 {\n  margin: 0;\n  color: var(--color-link);\n  font-size: 2.1rem;\n  line-height: 1.35;\n}\n\n.home-purpose__lead {\n  margin: 16px 0 0;\n  max-width: 60rem;\n  color: rgba(77, 73, 96, 0.88);\n  line-height: 1.95;\n}\n\n.home-purpose__chips {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  margin-top: 24px;\n}\n\n.home-purpose__chips span {\n  display: inline-flex;\n  align-items: center;\n  height: 38px;\n  padding: 0 16px;\n  border-radius: 999px;\n  font-size: 0.92rem;\n  color: #5d4d68;\n  box-shadow: 0 10px 24px rgba(115, 90, 127, 0.1);\n}\n\n.home-purpose__chips span:nth-child(1) {\n  background: rgba(240, 108, 141, 0.14);\n}\n\n.home-purpose__chips span:nth-child(2) {\n  background: rgba(119, 184, 255, 0.16);\n}\n\n.home-purpose__chips span:nth-child(3) {\n  background: rgba(105, 210, 176, 0.16);\n}\n\n.home-purpose__chips span:nth-child(4) {\n  background: rgba(169, 139, 255, 0.14);\n}\n\n.home-purpose__grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 20px;\n}\n\n.home-purpose__summary {\n  grid-column: 1 / -1;\n  padding: 26px 30px;\n}\n\n.home-purpose__summary h2 {\n  margin: 0;\n  color: var(--color-link);\n  font-size: 1.75rem;\n  line-height: 1.4;\n}\n\n.home-purpose__summary-text {\n  margin: 12px 0 0;\n  color: rgba(77, 73, 96, 0.88);\n  line-height: 1.85;\n}\n\n.home-purpose__card {\n  position: relative;\n  padding: 26px;\n  border: 1px solid rgba(255, 255, 255, 0.72);\n  border-radius: 26px;\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.92) 0%, rgba(252, 249, 255, 0.92) 100%);\n  box-shadow: 0 16px 34px rgba(96, 79, 116, 0.08);\n  transition:\n    transform 0.22s ease,\n    box-shadow 0.22s ease;\n  will-change: transform;\n}\n\n.home-purpose__card::before {\n  content: \"\";\n  position: absolute;\n  inset: 0 auto auto 0;\n  width: 100%;\n  height: 5px;\n  border-radius: 26px 26px 0 0;\n}\n\n.home-purpose__card:nth-child(1)::before {\n  background: linear-gradient(90deg, var(--sakura-pink), var(--sakura-peach));\n}\n\n.home-purpose__card:nth-child(2)::before {\n  background: linear-gradient(90deg, var(--sakura-sky), var(--sakura-lilac));\n}\n\n.home-purpose__card:nth-child(3)::before {\n  background: linear-gradient(90deg, var(--sakura-mint), var(--sakura-sky));\n}\n\n.home-purpose__card:hover {\n  transform: translateY(-6px);\n  box-shadow: 0 22px 40px rgba(96, 79, 116, 0.14);\n}\n\n.home-purpose__badge {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 42px;\n  height: 42px;\n  margin-bottom: 16px;\n  border-radius: 50%;\n  background: rgba(240, 108, 141, 0.1);\n  color: var(--sakura-pink);\n  font-weight: 700;\n}\n\n.home-purpose__card:nth-child(2) .home-purpose__badge {\n  background: rgba(119, 184, 255, 0.14);\n  color: var(--sakura-sky);\n}\n\n.home-purpose__card:nth-child(3) .home-purpose__badge {\n  background: rgba(105, 210, 176, 0.14);\n  color: var(--sakura-mint);\n}\n\n.home-purpose__card h3,\n.home-notes__aside-card h3 {\n  margin: 0 0 12px;\n  color: var(--color-link);\n  font-size: 1.12rem;\n}\n\n.home-purpose__card p,\n.home-notes__aside-card p,\n.home-notes__panel li {\n  margin: 0;\n  color: rgba(82, 76, 100, 0.92);\n  line-height: 1.9;\n}\n\n.post-categories-wrapper {\n  gap: 22px !important;\n  margin-bottom: 34px !important;\n}\n\n.post-categories-wrap {\n  border-radius: 28px !important;\n  overflow: hidden;\n  box-shadow: 0 18px 42px rgba(96, 79, 116, 0.14);\n  transition:\n    transform 0.22s ease,\n    box-shadow 0.22s ease !important;\n  will-change: transform;\n}\n\n.post-categories-wrap:hover {\n  transform: translateY(-6px);\n}\n\n.post-categories-cover::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background:\n    linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, rgba(44, 28, 56, 0.46) 100%),\n    linear-gradient(120deg, rgba(240, 108, 141, 0.2) 0%, rgba(119, 184, 255, 0.18) 100%);\n}\n\n.post-categories-cover h2,\n.post-categories-cover h3 {\n  position: relative;\n  z-index: 1;\n  text-shadow: 0 10px 24px rgba(0, 0, 0, 0.22);\n}\n\n.home-notes {\n  display: grid;\n  grid-template-columns: minmax(0, 1.45fr) minmax(300px, 1fr);\n  gap: 20px;\n}\n\n.home-notes__panel {\n  padding: 30px 34px;\n}\n\n.home-notes__panel ul {\n  margin: 18px 0 0;\n  padding-left: 1.2rem;\n}\n\n.home-notes__panel li::marker {\n  color: var(--sakura-pink);\n}\n\n.home-notes__panel li + li {\n  margin-top: 10px;\n}\n\n.home-notes__aside {\n  display: grid;\n  gap: 20px;\n}\n\n.home-notes__aside-card {\n  padding: 24px;\n  transition:\n    transform 0.22s ease,\n    box-shadow 0.22s ease;\n  will-change: transform;\n}\n\n.home-notes__aside-card:hover {\n  transform: translateY(-5px);\n  box-shadow: 0 18px 40px rgba(96, 79, 116, 0.14);\n}\n\n.home-notes__aside-card:nth-child(1) {\n  border-color: rgba(240, 108, 141, 0.16);\n}\n\n.home-notes__aside-card:nth-child(2) {\n  border-color: rgba(119, 184, 255, 0.18);\n}\n\n.home-notes__aside-card:nth-child(3) {\n  border-color: rgba(105, 210, 176, 0.18);\n}\n\n.home-notes__aside-card span {\n  display: inline-block;\n  margin-bottom: 14px;\n  font-size: 0.88rem;\n  font-weight: 700;\n  letter-spacing: 0.12em;\n}\n\n.home-notes__aside-card:nth-child(1) span {\n  color: var(--sakura-pink);\n}\n\n.home-notes__aside-card:nth-child(2) span {\n  color: var(--sakura-sky);\n}\n\n.home-notes__aside-card:nth-child(3) span {\n  color: var(--sakura-mint);\n}\n\n.post-wrap {\n  height: 248px;\n  border: 1px solid rgba(255, 255, 255, 0.72);\n  border-radius: 30px;\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.84) 0%, rgba(255, 248, 251, 0.92) 100%);\n  box-shadow: var(--sakura-shadow);\n  transition:\n    transform 0.22s ease,\n    box-shadow 0.22s ease;\n  will-change: transform;\n  contain: layout paint style;\n}\n\n.post-wrapper:hover .post-wrap {\n  transform: translateY(-6px);\n  box-shadow: 0 22px 42px rgba(96, 79, 116, 0.16);\n}\n\n.post-cover.left,\n.post-cover.right {\n  clip-path: none !important;\n  -webkit-clip-path: none !important;\n  border-radius: 30px !important;\n  margin: 14px;\n  width: calc(40% - 28px);\n}\n\n.post-cover img {\n  border-radius: 24px;\n}\n\n.post-info {\n  padding: 24px 24px 24px 6px;\n}\n\n.post-meta {\n  justify-content: flex-start;\n  flex-wrap: wrap;\n  gap: 8px 0;\n}\n\n.post-meta span {\n  display: inline-flex;\n  align-items: center;\n  height: 30px;\n  margin: 0 10px 0 0 !important;\n  padding: 0 12px;\n  border-radius: 999px;\n  background: rgba(240, 108, 141, 0.08);\n  color: #7a6687 !important;\n  font-size: 0.82rem !important;\n}\n\n.post-meta > span:nth-child(2n) {\n  background: rgba(119, 184, 255, 0.1);\n}\n\n.post-title {\n  padding: 18px 0 14px;\n  font-size: 1.55rem;\n  font-weight: 600;\n  white-space: normal;\n  line-height: 1.45;\n  transition: color 0.22s ease;\n}\n\n.post-wrapper:hover .post-title {\n  color: var(--sakura-pink);\n}\n\n.post-article {\n  line-height: 1.95;\n  color: rgba(85, 79, 103, 0.88);\n}\n\n.post-sticky {\n  top: 16px;\n  left: 16px;\n  width: auto;\n  min-width: 84px;\n  height: 36px;\n  padding: 0 14px;\n  border-radius: 999px;\n  background: rgba(255, 255, 255, 0.88);\n  color: var(--sakura-pink);\n  box-shadow: 0 10px 24px rgba(96, 79, 116, 0.12);\n}\n\n.article-inner,\n#comments,\n#article-nav .article-nav-link-wrap {\n  border: 1px solid rgba(255, 255, 255, 0.72);\n  border-radius: 30px;\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.86) 0%, rgba(255, 248, 251, 0.94) 100%);\n  box-shadow: var(--sakura-shadow);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n}\n\n.article-inner {\n  padding: 8px 0 0;\n}\n\n.article-meta {\n  padding: 8px 28px 0;\n}\n\n.article-date {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n}\n\n.article-date-link {\n  display: inline-flex;\n  align-items: center;\n  min-height: 32px;\n  padding: 0 14px;\n  border-radius: 999px;\n  background: rgba(240, 108, 141, 0.08);\n  color: #7a6687 !important;\n}\n\n.article-date-link.icon-calendar-plus {\n  background: rgba(119, 184, 255, 0.1);\n}\n\n.article-inner .hr-line {\n  margin: 18px 28px 22px;\n  background: linear-gradient(90deg, rgba(240, 108, 141, 0.42), rgba(119, 184, 255, 0.18), rgba(105, 210, 176, 0.2));\n  height: 2px;\n}\n\n.article-entry {\n  padding: 0 28px;\n}\n\n.article-entry p,\n.article-entry li {\n  line-height: 1.95;\n  color: rgba(85, 79, 103, 0.9);\n}\n\n.article-entry h2,\n.article-entry h3,\n.article-entry h4 {\n  font-weight: 600;\n}\n\n.article-entry h2 {\n  position: relative;\n  margin-top: 2.2em;\n  padding-left: 18px;\n}\n\n.article-entry h2::before {\n  content: \"\";\n  position: absolute;\n  left: 0;\n  top: 0.45em;\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: linear-gradient(135deg, var(--sakura-pink), var(--sakura-sky));\n  box-shadow: 0 0 0 6px rgba(240, 108, 141, 0.08);\n}\n\n.article-entry ul li::marker,\n.article-entry ol li::marker {\n  color: var(--sakura-pink);\n}\n\n.article-footer {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  padding: 24px 28px 28px;\n}\n\n.article-category-link,\n.article-tag-list-link,\n.article-comment-link,\n.article-visitor-link {\n  display: inline-flex;\n  align-items: center;\n  min-height: 36px;\n  padding: 0 14px;\n  border-radius: 999px;\n  background: rgba(255, 255, 255, 0.84);\n  box-shadow: 0 10px 24px rgba(96, 79, 116, 0.08);\n  transition:\n    transform 0.22s ease,\n    background-color 0.22s ease,\n    box-shadow 0.22s ease;\n  will-change: transform;\n}\n\n.article-category-link {\n  background: rgba(240, 108, 141, 0.1);\n  color: var(--sakura-pink) !important;\n}\n\n.article-tag-list {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.article-tag-list-item {\n  margin: 0 !important;\n}\n\n.article-tag-list-link {\n  background: rgba(119, 184, 255, 0.1);\n  color: #5f6faa !important;\n}\n\n.article-category-link:hover,\n.article-tag-list-link:hover,\n.article-comment-link:hover,\n.article-visitor-link:hover {\n  transform: translateY(-3px);\n}\n\n#article-nav {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 18px;\n}\n\n#article-nav .article-nav-link-wrap {\n  overflow: hidden;\n  min-height: 180px;\n}\n\n#article-nav .article-nav-link-wrap > a {\n  z-index: 3;\n}\n\n#article-nav .article-nav-caption,\n#article-nav .article-nav-title {\n  position: relative;\n  z-index: 1;\n}\n\n#article-nav .article-nav-caption {\n  color: rgba(255, 255, 255, 0.84);\n}\n\n#article-nav .article-nav-title {\n  color: #fff;\n  text-shadow: 0 10px 24px rgba(0, 0, 0, 0.22);\n}\n\n#article-nav .article-nav-link-wrap::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background:\n    linear-gradient(180deg, rgba(255, 255, 255, 0.06) 0%, rgba(30, 16, 40, 0.5) 100%),\n    linear-gradient(120deg, rgba(240, 108, 141, 0.18) 0%, rgba(119, 184, 255, 0.16) 100%);\n}\n\n#comments {\n  padding: 24px 28px;\n}\n\n.widget-wrap {\n  border: 1px solid rgba(255, 255, 255, 0.72);\n  border-radius: 28px;\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.84) 0%, rgba(250, 246, 255, 0.92) 100%);\n  box-shadow: var(--sakura-shadow);\n  transition:\n    transform 0.22s ease,\n    box-shadow 0.22s ease;\n  will-change: transform;\n  contain: layout paint style;\n}\n\n.widget-wrap:hover {\n  transform: translateY(-4px);\n  box-shadow: 0 20px 38px rgba(96, 79, 116, 0.14);\n}\n\n.widget-title {\n  letter-spacing: 0.16em;\n  color: #695a7b;\n}\n\n.widget li::before {\n  border-radius: 999px;\n}\n\n.widget a:hover,\n.widget span:hover {\n  color: var(--sakura-pink);\n}\n\n.sidebar-author {\n  padding: 22px 20px;\n  border-radius: 28px;\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.8) 0%, rgba(255, 245, 249, 0.9) 100%);\n  box-shadow: var(--sakura-shadow);\n}\n\n.sidebar-author img {\n  transition: transform 0.35s ease;\n  will-change: transform;\n}\n\n.sidebar-author:hover img {\n  transform: scale(1.03);\n}\n\n.sidebar-state {\n  margin-top: 18px;\n  border-radius: 22px;\n  background: rgba(255, 255, 255, 0.7);\n}\n\n[data-theme=\"dark\"] .home-purpose__lead,\n[data-theme=\"dark\"] .home-purpose__summary-text,\n[data-theme=\"dark\"] .home-purpose__card p,\n[data-theme=\"dark\"] .home-notes__aside-card p,\n[data-theme=\"dark\"] .home-notes__panel li,\n[data-theme=\"dark\"] .post-article {\n  color: rgba(231, 228, 238, 0.88);\n}\n\n[data-theme=\"dark\"] .home-purpose__card,\n[data-theme=\"dark\"] .post-wrap,\n[data-theme=\"dark\"] .widget-wrap,\n[data-theme=\"dark\"] .article-inner,\n[data-theme=\"dark\"] #comments,\n[data-theme=\"dark\"] #article-nav .article-nav-link-wrap,\n[data-theme=\"dark\"] .sidebar-author,\n[data-theme=\"dark\"] .sidebar-state {\n  border-color: rgba(255, 255, 255, 0.08);\n  background: linear-gradient(180deg, rgba(29, 32, 43, 0.84) 0%, rgba(21, 24, 34, 0.94) 100%);\n}\n\n[data-theme=\"dark\"] .post-meta span {\n  color: rgba(233, 226, 241, 0.88) !important;\n  background: rgba(240, 108, 141, 0.16);\n}\n\n[data-theme=\"dark\"] .article-entry p,\n[data-theme=\"dark\"] .article-entry li {\n  color: rgba(231, 228, 238, 0.88);\n}\n\n[data-theme=\"dark\"] .article-date-link,\n[data-theme=\"dark\"] .article-category-link,\n[data-theme=\"dark\"] .article-tag-list-link,\n[data-theme=\"dark\"] .article-comment-link,\n[data-theme=\"dark\"] .article-visitor-link {\n  background: rgba(255, 255, 255, 0.08);\n  color: rgba(233, 226, 241, 0.9) !important;\n}\n\n[data-theme=\"dark\"] .post-meta > span:nth-child(2n) {\n  background: rgba(119, 184, 255, 0.18);\n}\n\n@media (max-width: 900px) {\n  #header-nav {\n    width: calc(100% - 20px);\n    padding: 8px 12px;\n  }\n\n  .main-nav-link {\n    min-height: 36px;\n    padding: 0 14px;\n    font-size: 0.92rem;\n  }\n\n  .home-purpose__grid,\n  .home-notes {\n    grid-template-columns: 1fr;\n  }\n\n  .home-purpose__intro,\n  .home-notes__panel {\n    padding: 24px;\n  }\n\n  .home-purpose__intro h2,\n  .home-notes__panel h2 {\n    font-size: 1.68rem;\n  }\n\n  .post-wrap {\n    height: auto;\n  }\n\n  .post-cover.left,\n  .post-cover.right {\n    width: calc(100% - 28px);\n  }\n\n  .post-info {\n    padding: 8px 20px 22px;\n  }\n\n  .article-entry,\n  .article-footer,\n  .article-meta,\n  #comments {\n    padding-left: 20px;\n    padding-right: 20px;\n  }\n\n  #article-nav {\n    grid-template-columns: 1fr;\n  }\n}\n\n/* =========================================\n   Performance Optimizations\n   ========================================= */\n\n/* 尊重用户减少动画偏好 */\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n\n  html {\n    scroll-behavior: auto !important;\n  }\n}\n\n/* 长列表渲染优化 - 只渲染视口内内容 */\n.post-wrapper,\n#archives .al_post_list li,\n.widget-wrap li {\n  content-visibility: auto;\n  contain-intrinsic-size: 260px 100%;\n}\n\n/* 文章卡片提升合成层 */\n.post-wrap,\n.home-purpose__card,\n.home-notes__aside-card,\n.widget-wrap {\n  transform: translateZ(0);\n  backface-visibility: hidden;\n  perspective: 1000px;\n}\n\n/* 禁用移动端的模糊毛玻璃效果，减少 GPU 压力 */\n@media (max-width: 900px) {\n  .home-purpose__intro,\n  .home-purpose__summary,\n  .home-notes__panel,\n  .home-notes__aside-card,\n  .widget-wrap,\n  .post-wrap,\n  .article-inner,\n  #comments,\n  #article-nav .article-nav-link-wrap,\n  .sidebar-author {\n    backdrop-filter: none !important;\n    -webkit-backdrop-filter: none !important;\n  }\n}\n\n/* 文章内容排版优化 - 减少重排 */\n.article-entry {\n  overflow-wrap: break-word;\n  word-break: break-word;\n  hyphens: auto;\n}\n\n/* 图片懒加载优化 */\nimg {\n  content-visibility: auto;\n}\n\n/* 减少 shadow 重绘 - 提升到合成层 */\n.notice,\n.top-feature,\n.post-list-thumb,\n.author-profile {\n  transform: translateZ(0);\n  backface-visibility: hidden;\n}\n","source":"css/site-home.css","raw":":root {\n  --sakura-pink: #f06c8d;\n  --sakura-peach: #ffb38a;\n  --sakura-sky: #77b8ff;\n  --sakura-mint: #69d2b0;\n  --sakura-lilac: #a98bff;\n  --sakura-border: rgba(240, 108, 141, 0.12);\n  --sakura-shadow: 0 20px 45px rgba(96, 79, 116, 0.12);\n}\n\nhtml {\n  scroll-behavior: smooth;\n}\n\nbody {\n  background:\n    radial-gradient(circle at top left, rgba(240, 108, 141, 0.08), transparent 35%),\n    radial-gradient(circle at top right, rgba(119, 184, 255, 0.08), transparent 40%),\n    linear-gradient(180deg, #fffafc 0%, #f7f9ff 50%, #fffefc 100%);\n  background-attachment: fixed;\n}\n\n#header::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background:\n    linear-gradient(120deg, rgba(240, 108, 141, 0.18) 0%, rgba(255, 179, 138, 0.1) 30%, rgba(119, 184, 255, 0.1) 68%, rgba(169, 139, 255, 0.1) 100%);\n  z-index: -1;\n}\n\n#header::after {\n  content: \"\";\n  position: absolute;\n  inset: auto 0 0;\n  height: 160px;\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(255, 250, 252, 0.82) 72%, rgba(255, 250, 252, 0.96) 100%);\n  z-index: -1;\n  pointer-events: none;\n}\n\n#header #subtitle,\n#header h1 {\n  text-shadow: 0 10px 24px rgba(64, 48, 74, 0.14);\n}\n\n#header-nav {\n  top: 16px;\n  left: 50%;\n  right: auto;\n  width: min(92%, 880px);\n  padding: 10px 16px;\n  border: 1px solid rgba(255, 255, 255, 0.6);\n  border-radius: 999px;\n  background: rgba(255, 255, 255, 0.72);\n  backdrop-filter: blur(18px);\n  -webkit-backdrop-filter: blur(18px);\n  box-shadow: 0 18px 40px rgba(96, 79, 116, 0.14);\n  transform: translateX(-50%);\n  justify-content: space-between;\n}\n\n#header-nav:hover {\n  background: rgba(255, 255, 255, 0.8);\n}\n\n#header-nav.header-nav-hidden {\n  top: -96px;\n}\n\n#main-nav,\n#sub-nav {\n  gap: 8px;\n}\n\n.main-nav-icon {\n  display: none !important;\n}\n\n.main-nav-link-wrap {\n  padding: 0 !important;\n  border-radius: 999px;\n  opacity: 1;\n}\n\n.main-nav-link {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 40px;\n  padding: 0 18px;\n  border-radius: 999px;\n  color: #7b5d7c;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  background: transparent;\n  transition:\n    background-color 0.22s ease,\n    color 0.22s ease,\n    box-shadow 0.22s ease;\n}\n\n.main-nav-link-wrap:hover .main-nav-link {\n  color: #fff;\n  background: linear-gradient(135deg, var(--sakura-pink), #f7a2b6);\n  box-shadow: 0 12px 26px rgba(240, 108, 141, 0.26);\n}\n\n#sub-nav .nav-icon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 40px;\n  height: 40px;\n  padding: 0;\n  border-radius: 50%;\n  color: #8f6e8c;\n  background: rgba(240, 108, 141, 0.08);\n  transition:\n    background-color 0.22s ease,\n    color 0.22s ease,\n    transform 0.22s ease,\n    box-shadow 0.22s ease;\n  will-change: transform;\n}\n\n#sub-nav .nav-icon:hover {\n  color: #fff;\n  background: linear-gradient(135deg, var(--sakura-sky), var(--sakura-lilac));\n  box-shadow: 0 12px 26px rgba(119, 184, 255, 0.22);\n  transform: translateY(-2px);\n}\n\n[data-theme=\"dark\"] #header-nav {\n  border-color: rgba(255, 255, 255, 0.08);\n  background: rgba(24, 28, 37, 0.72);\n  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);\n}\n\n[data-theme=\"dark\"] #header-nav:hover {\n  background: rgba(24, 28, 37, 0.82);\n}\n\n[data-theme=\"dark\"] .main-nav-link {\n  color: rgba(237, 227, 238, 0.9);\n}\n\n[data-theme=\"dark\"] #sub-nav .nav-icon {\n  color: rgba(237, 227, 238, 0.9);\n  background: rgba(255, 255, 255, 0.08);\n}\n\n.home-purpose,\n.home-notes {\n  margin: 0 0 32px;\n}\n\n.home-purpose {\n  display: grid;\n  gap: 24px;\n}\n\n.home-purpose__intro,\n.home-purpose__summary,\n.home-notes__panel,\n.home-notes__aside-card,\n.widget-wrap,\n.post-wrap {\n  backdrop-filter: blur(8px) saturate(1.2);\n  -webkit-backdrop-filter: blur(8px) saturate(1.2);\n  transform: translateZ(0);\n  -webkit-transform: translateZ(0);\n}\n\n.home-purpose__intro,\n.home-purpose__summary,\n.home-notes__panel,\n.home-notes__aside-card {\n  border-radius: 30px;\n  border: 1px solid var(--sakura-border);\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.82) 0%, rgba(255, 247, 250, 0.92) 100%);\n  box-shadow: var(--sakura-shadow);\n}\n\n[data-theme=\"dark\"] bo